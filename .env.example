# ════════════════════════════════════════════════════
# .env.example – Copy thành .env và điền thông tin
# ════════════════════════════════════════════════════

# ── TELEGRAM (bắt buộc) ───────────────────────────────────────────────────────
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Tuỳ chọn: username Telegram được phép claim bot, không cần dấu @.
# Nếu để trống, người đầu tiên gửi /start sẽ trở thành owner.
TELEGRAM_OWNER_USERNAME=your_telegram_username

# ── LỚP HỌC ──────────────────────────────────────────────────────────────────
# Danh sách class_id, cách nhau bởi dấu phẩy
CLASS_IDS=TA01.NVSPTH.QY01,TA01-NVSPGVTHCS.THPT-QY01

# ── LỊCH ĐỒNG BỘ ─────────────────────────────────────────────────────────────
# Các giờ chạy đồng bộ trong ngày (giờ Việt Nam)
SYNC_HOURS=0,7,12,17

# Nhắc nhở trước bao nhiêu giờ (24 = 1 ngày trước)
NOTIFY_BEFORE_HOURS=24

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/schedule.db

# ── TIMEZONE ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Ho_Chi_Minh

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── WORLD CUP 2026 (tuỳ chọn) ───────────────────────────────────────────────
# Dữ liệu lấy từ ESPN public endpoint, không cần API token.
# Bật/tắt module WC (mặc định bật trong thời gian WC 2026: 11/6 - 19/7/2026)
WC_ENABLED=true

# Giờ thông báo lịch trận hàng ngày (mặc định 0h)
WC_DAILY_NOTIFY_HOUR=0

# Kiểm tra kết quả mỗi bao nhiêu phút (0 = tắt, khuyến nghị 60)
WC_LIVE_CHECK_MINUTES=60

# ── GOOGLE CALENDAR (tuỳ chọn) ───────────────────────────────────────────────
# Đặt thành true để bật đồng bộ Google Calendar
GOOGLE_CALENDAR_ENABLED=false

# ID calendar (dùng "primary" cho calendar chính)
GOOGLE_CALENDAR_ID=primary

# Đường dẫn tới file credentials.json tải từ Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json

# File token sẽ được tạo tự động sau lần đăng nhập đầu tiên
GOOGLE_TOKEN_FILE=data/token.json
